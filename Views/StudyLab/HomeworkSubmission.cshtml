@using Classly.Models.Courses
@using Newtonsoft.Json
@model HomeworkSubmission
@{
    var notes = JsonConvert.DeserializeObject<CourseNote>(ViewBag.Notes);
    GeneratedHomeworkModel homeworkTasks = JsonConvert.DeserializeObject<GeneratedHomeworkModel>(notes.Homework);
}

<h1>Homework submission</h1>

<div class="row">
    <div class="col">
        <form method="post" action="SaveHomework">
            <input type="hidden" name="LinkedCourseNoteId" value="@Model.LinkedCourseNoteId" />
            <input type="hidden" name="Id" value="@Model.Id" />
            <textarea style="min-height:1000px;" class="form-control" name="Content">
                @(Model.Content)
            </textarea>
            <div>
                <label>Mark as complete?</label>
                <input class="form-check-input" name="MarkAsComplete" type="checkbox" value="true"/>
            </div>
            <button class="btn btn-primary">Save</button>
        </form>
    </div>
    <div class="col">
        <h2>Tasks</h2>
      @*   @Html.Raw(notes.Homework) *@
      <h3>Fill in the blanks</h3>
      <ul>
            @foreach (var q in homeworkTasks.FillInTheBlanksQuestions)
            {
                <li>@q.SentenceWithBlanks</li>
            }
      </ul>
      <h3>Select the correct option</h3>
        @foreach(var q in homeworkTasks.QuestionsWithOptions)
        {
            <p>@q.Question</p><br/>
            <ul>
                @foreach (var a in q.PossibleAnswers)
                {
                    <li>@a</li>
                }
            </ul>
        }
        <h3>Sentence Matching</h3>
        <div class="row">
            <div class="col">
                <ul>
                    @* will likley need to shuffle these up *@
                    @foreach(var p1 in homeworkTasks.SentenceMatching.Pairs.Select(x => x.FirstHalf))
                    {
                        <li>@p1</li>
                    }
                </ul>
            </div>
            <div class="col">
                <ul>
                    @foreach (var p1 in homeworkTasks.SentenceMatching.Pairs.Select(x => x.SecondHalf))
                    {
                        <li>@p1</li>
                    }
                </ul>
            </div>
        </div>
        <h3>Create your own sentences which use the words below</h3>
        <ul>
            @foreach(var q in homeworkTasks.CreateYourOwnSentences)
            {
                <li>@q</li>
            }
        </ul>

        <h2>Lesson notes</h2>
        @Html.Raw(notes.Notes)
    </div>
</div>