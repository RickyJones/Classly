@using Classly.Services.Data
@using System.Security.Claims
@inject IUserService userService;
@*
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
    .copy-box {
        background-color: #fff; /* white background */
        border: 1px solid #dee2e6; /* light gray border */
        border-radius: 0.5rem; /* rounded corners */
        padding: 0.75rem 1rem; /* breathing room */
        box-shadow: 0 4px 8px rgba(0,0,0,0.1); /* subtle drop shadow */
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .copy-box:hover {
            transform: translateY(-2px); /* lift on hover */
            box-shadow: 0 6px 12px rgba(0,0,0,0.15);
        }

</style>
*@
@{
    Guid? tutorId = Guid.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var validId) ? validId : null;
}

<div class="student-management">

    <h2>Your Students</h2>

    <div class="row">

        <!-- LEFT: Student list -->
        <div class="col">
            <ul class="list-group">
                @foreach (var student in await userService.GetStudentsAsync(tutorId))
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @student.Name
                        <a href="mailto:@student.Email">@student.Email</a>
                    </li>
                }
            </ul>
        </div>

        <!-- RIGHT: Invite new students -->
        <div class="col">
            <h3>Looking to invite new students?</h3>

            <p>
                Copy this link to send them an invite to create a Classly account
                that will connect you and your new student
            </p>

            @{
                var registerUrl = Url.Action(
                    "Register",
                    "Login",
                    new { linkingTutorId = tutorId },
                    ViewContext.HttpContext.Request.Scheme
                );
            }

            <div class="copy-box d-flex align-items-center">
                <p class="mb-0 me-2" id="registerUrl">@registerUrl</p>

                <button class="btn btn-outline-secondary btn-sm"
                        onclick="copyToClipboard()"
                        title="Copy link">
                    <i class="bi bi-clipboard"></i>
                </button>            
                </div>