@{
    ViewData["Title"] = "Home Page";
}

<div class="tutor-dashboard-page tutor-dashboard">
    <!-- Removed py-5, added tutor-dashboard-header -->
    <section class="text-center container tutor-dashboard-header">
        <div class="row">
            <div class="col-lg-6 col-md-8 mx-auto">
                <h1 class="fw-bold">Tutor Dashboard</h1>
                @* <p class="lead text-body-secondary">Choose where you'd like to go</p> *@
            </div>
        </div>
    </section>

    <div class="album py-5 bg-body-tertiary">
        <div class="container">
            <div class="row">
                <!-- Invite a new student -->
                <div class="col">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <p class="card-text">
                                Invite a new student
                            </p>
                            <div class="d-flex justify-content-center align-items-center">
                                <div class="btn-group">
                                    <a href="@Url.Action("Index", "StudentManagement")">Go To Invites</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- View your students -->
                <div class="col">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <p class="card-text">
                                View your students
                            </p>
                            <div class="d-flex justify-content-center align-items-center">
                                <div class="btn-group">
                                    <a href="@Url.Action("Index", "StudentManagement")">Go to Students</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Future card example
                <div class="col">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <p class="card-text">
                                Join the Community
                            </p>
                            <div class="d-flex justify-content-center align-items-center">
                                <div class="btn-group">
                                    <a onclick="alert('Coming Soon!')">Go to Community...</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                *@
            </div>
        </div>
        <br/>
        <br/>
    </div>
</div>
