@using Classly.Models.Courses
@model CourseNote

<link rel="stylesheet" href="~/css/notes.css" asp-append-version="true" />

@{
}
@using Markdig
<h1 class="notes-title">@ViewBag.Student's Notes</h1>

<div class="notes-meta mb-3">
    <label>Teacher: @ViewBag.Teacher</label><br />
    <label>Student: @ViewBag.Student</label>
</div>

<div class="row">
    <div class="col">
        <h3 class="notes-section-heading">Vocabulary</h3>

        <div class="notes-content">
            @Html.Raw(Model.Notes)
        </div>
    </div>
</div>

<!-- Homework -->
<h3 class="card-heading">Homework</h3>

<div class="row">
    <div class="col">
        <div class="card shadow-sm mb-3 homework-card">
    <div class="card-body">
                <label><b>Difficulty: @Model.Difficulty</b></label>
                @Html.Raw(Model.Homework.Replace("\n", "<br/>"))
            </div>
        </div>
    </div>
</div>

<!-- Next lesson plan -->
<h3 class="card-heading">Next lesson plan</h3>

<div class="row">
    <div class="col">
        <div class="card shadow-sm mb-3 NextLessonPlan-card">
            <div class="card-body">
                <label><b>Difficulty: @Model.Difficulty</b></label>
                @Html.Raw(Model.NextLessonPlan.Replace("\n", "<br/>"))
            </div>
        </div>
    </div>
</div>




