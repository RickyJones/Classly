@using Classly.Models.Courses
@using Newtonsoft.Json
@model List<CourseNote>
@{
    ViewData["Title"] = "Course Notes";
    var currentNoteId = ViewBag.CurrentNoteId;
    var currentNote = Model.First(x => x.Id == currentNoteId);
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar with date stamps -->
        <div class="col-md-3 border-end">
            <h5>Notes History</h5>
            <ul class="list-group">
                @foreach (var note in Model)
                {
                    <li class="list-group-item">
                        <a asp-action="Details" asp-route-id="@note.Id">
                            @note.CreatedAt.ToString("dd MMM yyyy HH:mm")
                        </a>
                    </li>
                }
            </ul>
        </div>

        <!-- Main content -->
        <div class="col-md-9">

            <h3>Course Note (@currentNote.Difficulty)</h3>
            <p><strong>Tutor:</strong> @currentNote.TutorId</p>
            <p><strong>Student:</strong> @currentNote.StudentId</p>
            <p><strong>Date:</strong> @currentNote.CreatedAt.ToString("f")</p>
            <button onclick="@Url.Action("ViewNote", new {currentNoteId = currentNote.Id})">View</button>

            <hr />

            <h4>Notes</h4>
            <pre class="bg-light p-3">@currentNote.Notes</pre>

            <h4>Homework</h4>
            <pre class="bg-light p-3">
                @{
                    GeneratedHomeworkModel homeworkTasks = JsonConvert.DeserializeObject<GeneratedHomeworkModel>(currentNote.Homework);
                }
            <h3 class="card-title">Homework</h3>
            <h3>Fill in the blanks</h3>
            <ul>
                    @foreach (var q in homeworkTasks.FillInTheBlanksQuestions)
                    {
                <li>@q.SentenceWithBlanks</li>
                    }
                </ul>
            <h3>Select the correct option</h3>
                @foreach (var q in homeworkTasks.QuestionsWithOptions)
                {
                <p>@q.Question</p>
                
                <br />
                <ul>
                            @foreach (var a in q.PossibleAnswers)
                            {
                    <li>@a</li>
                            }
                        </ul>
                }
            <h3>Sentence Matching</h3>
            <div class="row">
            <div class="col">
            <ul>
                            @* will likley need to shuffle these up *@
                            @foreach (var p1 in homeworkTasks.SentenceMatching.Pairs.Select(x => x.FirstHalf))
                            {
                <li>@p1</li>
                            }
                        </ul>
                    </div>
            <div class="col">
            <ul>
                            @foreach (var p1 in homeworkTasks.SentenceMatching.Pairs.Select(x => x.SecondHalf))
                            {
                <li>@p1</li>
                            }
                        </ul>
                    </div>
                </div>
            <h3>Create your own sentences which use the words below</h3>
            <ul>
                    @foreach (var q in homeworkTasks.CreateYourOwnSentences.Select(x => x.WordToInclude))
                    {
                <li>@q</li>
                    }
                </ul>
            </pre>
        </div>
    </div>
</div>
